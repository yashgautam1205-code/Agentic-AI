# Development
ENVIRONMENT=development
# The backend defaults to SQLite and creates a local .jwt_secret for development.
# A Gemini key is needed to generate real AI content, but not to start the API.
GEMINI_API_KEY=

# Optional local overrides. FFmpeg and FFprobe are discovered from PATH by default.
# GEMINI_TIMEOUT_SECONDS=60
# MAX_FILE_SIZE_MB=500
# FFMPEG_PATH=
# FFPROBE_PATH=

# Optional OAuth authorization-URL scaffold; callback exchange and publishing
# are not implemented. Client secrets are not currently used.
# OAUTH_STATE_SECRET=
# INSTAGRAM_APP_ID=
# INSTAGRAM_REDIRECT_URI=https://api.brandverse.example.com/api/integrations/instagram/callback
# YOUTUBE_CLIENT_ID=
# YOUTUBE_REDIRECT_URI=https://api.brandverse.example.com/api/integrations/youtube/callback
# LINKEDIN_CLIENT_ID=
# LINKEDIN_REDIRECT_URI=https://api.brandverse.example.com/api/integrations/linkedin/callback
# X_CLIENT_ID=
# X_REDIRECT_URI=https://api.brandverse.example.com/api/integrations/x/callback

# Production only: set these in the deployment environment, replacing the
# development ENVIRONMENT value above. Use persistent storage and a strong key.
# ENVIRONMENT=production
# JWT_SECRET_KEY=<generate-a-random-secret-at-least-32-characters>
# DATABASE_URL=postgresql+psycopg://user:password@db-host/brandverse
# UPLOAD_DIR=/var/lib/brandverse/uploads
# CORS_ORIGINS=https://your-frontend.example.com
